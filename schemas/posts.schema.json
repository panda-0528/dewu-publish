{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dewu-posts.schema.json",
  "title": "DewuPostsConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["posts"],
  "properties": {
    "posts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "album", "title", "body", "topics"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "album": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "color_name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "#"
            }
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "pattern": "^#[^\\s#]+$"
            }
          }
        }
      }
    }
  }
}
